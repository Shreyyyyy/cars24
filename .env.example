# Google Gemini API Key
# Obtain a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=

# Active Gemini LLM Model (e.g. gemini-2.5-flash, gemini-3.8-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-3.8-flash
NEXT_PUBLIC_GEMINI_MODEL=gemini-3.8-flash

# Output Length Mode:
# Options:
#   - small  : (alias: less, short) - strictly ~2-3 lines concise executive summary
#   - medium : (alias: normal, standard) - balanced medium-sized briefing
#   - large  : (alias: full, detailed) - comprehensive in-depth strategic analysis
OUTPUT_MODE=medium
NEXT_PUBLIC_OUTPUT_MODE=medium

# Semantic & Redis Cache Toggle:
# Options:
#   - true / on / 1  : enables ultra-fast sub-millisecond semantic & redis cache (default)
#   - false / off / 0: disables all caching, forcing fresh live engine execution on every query
CACHE_ENABLED=true
NEXT_PUBLIC_CACHE_ENABLED=true

# Client data source (datasets listed in the UI dataset picker; one is active at a time)
# Options:
#   - folder : CSV / Excel / JSON files in CLIENT_DATA_DIR (local path, mounted volume or network share)
CLIENT_SOURCE=folder
# Defaults to ./data/client
CLIENT_DATA_DIR=

# LLM cost tracking (server-side only; recorded in the llm_costs table, not shown in the UI)
# Optional override of Gemini prices in USD per 1M tokens, e.g.
# GEMINI_PRICING_JSON={"gemini-2.5-flash":{"input":0.30,"output":2.50,"cachedInput":0.03}}
GEMINI_PRICING_JSON=

# Per-question tracking row sent to a Power Automate flow that appends it to the SharePoint workbook
# (flow: "When an HTTP request is received" -> "Add a row into a table"). Keep the URL secret: it carries its own access signature.
TRACKING_FLOW_URL=
